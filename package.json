{
  "name": "protocol-bank",
  "version": "1.0.0",
  "private": true,
  "description": "Decentralized Cross-Border Payment Platform - SWIFT Alternative",
  "repository": {
    "type": "git",
    "url": "https://github.com/everest-an/Protocol-Bank.git"
  },
  "author": "Protocol Bank Team <everest9812@gmail.com>",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*",
    "contracts"
  ],
  "scripts": {
    "dev": "concurrently \"pnpm dev:frontend\" \"pnpm dev:backend\"",
    "dev:frontend": "pnpm --filter frontend dev",
    "dev:admin": "pnpm --filter admin dev",
    "dev:backend": "pnpm --filter backend dev",
    "build": "pnpm --filter frontend build && pnpm --filter admin build && pnpm --filter backend build",
    "build:frontend": "pnpm --filter frontend build",
    "build:admin": "pnpm --filter admin build",
    "build:backend": "pnpm --filter backend build",
    "test": "pnpm --filter \"./apps/**\" test",
    "lint": "pnpm --filter \"./apps/**\" lint",
    "clean": "pnpm --filter \"./apps/**\" clean && rm -rf node_modules"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}
