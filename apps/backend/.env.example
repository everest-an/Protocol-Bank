# Server Configuration
PORT=3001
NODE_ENV=production

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=protocol_bank
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# JWT Configuration
