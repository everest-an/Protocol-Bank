# Netting Engine Configuration

# Ethereum RPC URL (Mainnet)
ETHEREUM_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_API_KEY

# Sepolia RPC URL (Testnet)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY

# Netting Engine Private Key (DO NOT COMMIT!)
# This is the private key used to sign net positions
NETTING_ENGINE_PRIVATE_KEY=0x...

# ClearingHouse Contract Address
# Mainnet: 0x...
# Sepolia: 0x...
CLEARING_HOUSE_ADDRESS=0x...

# Settlement Schedule
# Hourly: 0 0 * * * * (default)
# Every 30 minutes: 0 */30 * * * *
# Daily at midnight: 0 0 0 * * *
SETTLEMENT_CRON_SCHEDULE=0 0 * * * *

# Database Configuration (if different from main app)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=protocol_bank
# DB_USER=postgres
# DB_PASSWORD=your_password
