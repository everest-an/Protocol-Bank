# Protocol Bank Frontend Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# Network Configuration
# ============================================

# Sepolia Testnet
VITE_SEPOLIA_CHAIN_ID=11155111
VITE_SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY
VITE_SEPOLIA_EXPLORER_URL=https://sepolia.etherscan.io

# Base Sepolia Testnet
VITE_BASE_SEPOLIA_CHAIN_ID=84532
VITE_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
VITE_BASE_SEPOLIA_EXPLORER_URL=https://sepolia.basescan.org

# Base Mainnet (Production)
VITE_BASE_MAINNET_CHAIN_ID=8453
VITE_BASE_MAINNET_RPC_URL=https://mainnet.base.org
VITE_BASE_MAINNET_EXPLORER_URL=https://basescan.org

# ============================================
# Smart Contract Addresses - Sepolia
# ============================================

VITE_SEPOLIA_X402_ADDRESS=0x...
VITE_SEPOLIA_USDC_ADDRESS=0x...
VITE_SEPOLIA_STREAM_PAYMENT_ADDRESS=0x...

# ============================================
# Smart Contract Addresses - Base Sepolia
# ============================================

VITE_BASE_SEPOLIA_X402_ADDRESS=0x...
VITE_BASE_SEPOLIA_USDC_ADDRESS=0x...
VITE_BASE_SEPOLIA_STREAM_PAYMENT_ADDRESS=0x...

# ============================================
# Backend API Configuration
# ============================================

VITE_API_BASE_URL=http://localhost:3001
VITE_API_TIMEOUT=30000

# ============================================
# Feature Flags
# ============================================

VITE_ENABLE_X402=true
VITE_ENABLE_STREAM_PAYMENTS=true
VITE_ENABLE_BATCH_PAYMENTS=true
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_AUTOMATION=true

# ============================================
# Analytics & Monitoring
# ============================================

VITE_GOOGLE_ANALYTICS_ID=
VITE_SENTRY_DSN=

# ============================================
# Development Settings
# ============================================

VITE_ENABLE_DEBUG=false
VITE_ENABLE_MOCK_DATA=false
